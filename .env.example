# Copy to .env and adjust. Every setting is optional.

# Port on the host machine.
PORT=8080

# Username of the server admin (the account that can manage other users).
# Leave empty and the first account created becomes admin.
ADMIN_USERNAME=

# Allow new people to create accounts. The first account can always be created.
ALLOW_REGISTRATION=true

# ReKindle+ apps (Mail, Quick ToDo, AirType, ...) are a paid feature of rekindle.ink and
# stay locked here. true unlocks them for every account on this server.
PLUS_FOR_ALL=false

# Set to true when a reverse proxy (Caddy, nginx, Traefik) sits in front.
TRUST_PROXY=true

# Largest file a user can upload to Files / Photo Frame, in MB.
MAX_UPLOAD_MB=100

# --- AI -----------------------------------------------------------------------
# Google Gemini key (https://aistudio.google.com/app/apikey). Powers Oracle AI and
# handwriting recognition in Quick ToDo.
GEMINI_API_KEY=
# Model for handwriting recognition (default: gemini-flash-latest).
OCR_MODEL=
# Or use any OpenAI-compatible API for handwriting recognition instead of Gemini:
OPENAI_BASE_URL=
OPENAI_API_KEY=

# --- Google Tasks / Calendar / Contacts sync -------------------------------------
# Needs your own OAuth client ID (type "Web application") and an HTTPS address.
# See selfhost/README.md for the exact setup.
GOOGLE_CLIENT_ID=

# --- Manga app -------------------------------------------------------------------
# Manhuagui mirror; use https://tw.manhuagui.com for Traditional Chinese.
MANHUAGUI_URL=
# Show titles Manhuagui marks R18.
MANHUAGUI_SHOW_R18=false

# --- Outgoing proxy ----------------------------------------------------------------
# archive.today (archive.ph, archive.is, ...) blocks many hosting networks. Requests to
# PROXY_DOMAINS go through this HTTP proxy on another machine: http://user:pass@host:port
PROXY_URL=
# Comma-separated; the default is the archive.today domains.
PROXY_DOMAINS=

# --- Pictures --------------------------------------------------------------------
# Hacker News pictures are scaled down to this width (pixels) for e-readers.
IMAGE_MAX_WIDTH=1080

# --- Other optional services ----------------------------------------------------
# Watchlist (The Movie Database, https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
# Pinterest app
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
